      [3,"3A","Why control source-code repositories and developer access?","Protect code integrity and confidentiality through authorized access, tracked changes, peer review, and controlled promotion to production."],
      [3,"3A","What is the purpose of configuration and release management?","Maintain approved versions and dependencies, test and authorize releases, and preserve a traceable record of what was deployed."],
      [3,"3B","Why reconcile converted data between legacy and replacement systems?","Demonstrate completeness and accuracy by comparing record counts, control totals, key fields, and exceptions before accepting conversion."],
