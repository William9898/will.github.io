      document.querySelector("#flashcard-answer").hidden = true;
      document.querySelector("#reveal-answer").textContent = "Show answer";
      document.querySelector("#reveal-answer").setAttribute("aria-expanded", "false");
      document.querySelector("#mark-review").classList.toggle("is-marked", state === "review");
      document.querySelector("#mark-mastered").classList.toggle("is-marked", state === "mastered");
      document.querySelector("#flashcard-status").textContent = state === "mastered" ? "Marked mastered" : state === "review" ? "Marked for review" : "Not marked yet";
      document.querySelector("#previous-card").disabled = currentFlashcardIndex === 0;
      document.querySelector("#next-card").disabled = currentFlashcardIndex === visibleFlashcards.length - 1;
    }

    function moveFlashcard(direction) {
      currentFlashcardIndex = Math.max(0, Math.min(visibleFlashcards.length - 1, currentFlashcardIndex + direction));
      updateFlashcards();
    }

    document.querySelector("#domain-filter").addEventListener("change", () => { currentFlashcardIndex = 0; updateFlashcards(); });
    document.querySelector("#status-filter").addEventListener("change", () => { currentFlashcardIndex = 0; updateFlashcards(); });
    document.querySelector("#shuffle-cards").addEventListener("click", () => {
      for (let index = flashcardOrder.length - 1; index > 0; index -= 1) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        [flashcardOrder[index], flashcardOrder[randomIndex]] = [flashcardOrder[randomIndex], flashcardOrder[index]];
      }
      currentFlashcardIndex = 0;
      updateFlashcards();
    });
    document.querySelector("#reveal-answer").addEventListener("click", () => {
      const answer = document.querySelector("#flashcard-answer");
      const button = document.querySelector("#reveal-answer");
      answer.hidden = !answer.hidden;
      button.textContent = answer.hidden ? "Show answer" : "Hide answer";
      button.setAttribute("aria-expanded", String(!answer.hidden));
    });
    document.querySelector("#previous-card").addEventListener("click", () => moveFlashcard(-1));
    document.querySelector("#next-card").addEventListener("click", () => moveFlashcard(1));
    document.querySelector("#mark-review").addEventListener("click", () => {
      flashcardState[visibleFlashcards[currentFlashcardIndex]] = "review";
      saveFlashcardState();
      updateFlashcards();
    });
    document.querySelector("#mark-mastered").addEventListener("click", () => {
      flashcardState[visibleFlashcards[currentFlashcardIndex]] = "mastered";
      saveFlashcardState();
      updateFlashcards();
    });

    updateFlashcards();
  </script>
</body>
</html>
