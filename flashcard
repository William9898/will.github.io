      [2,"2A","What does an integrated governance, risk, and compliance approach aim to achieve?","Coordinate oversight, risk responses, and compliance obligations so assurance is consistent and aligned with enterprise objectives."],
      [2,"2A","How should IT strategy and business intelligence support enterprise decisions?","IT strategy aligns capabilities and investment to business goals; business intelligence turns reliable data into information for informed decisions."],
      [2,"2A","What should effective information security governance establish?","Management direction, accountability, risk ownership, policies, and oversight that align security priorities with business objectives."],
      [2,"2A","What is the usual risk-management cycle?","Identify risks, analyze likelihood and impact, evaluate them against criteria, select treatment, assign owners, and monitor changes."],
      [2,"2A","What should a privacy program govern across the information lifecycle?","Collection, purpose and use, access, sharing, retention, data-subject rights, and secure disposal of personal information."],
      [2,"2A","Why maintain an enterprise data inventory and classification scheme?","Know what data exists, where it resides, who owns it, and which handling and protection requirements apply."],
      [2,"2A","What is the difference between a data owner and a data custodian?","The owner sets business classification and access requirements; the custodian implements and operates safeguards under those requirements."],
      [2,"2B","What is IT portfolio management intended to optimize?","The mix of IT investments and services so resources support strategic priorities and expected benefits are monitored."],
      [2,"2B","What should an auditor assess throughout the employee lifecycle?","Appropriate screening and onboarding, role-based access and training during employment, and timely asset return and access removal at transfer or termination."],
      [2,"2B","What is the purpose of enterprise change management?","Coordinate significant organizational changes, assess impacts and readiness, communicate responsibilities, and manage transition risks."],
      [2,"2B","What is the difference between a key performance indicator and a key risk indicator?","A KPI measures progress or performance against objectives; a KRI signals changing exposure or proximity to a risk threshold."],
      [2,"2B","What should IT quality management and operational excellence emphasize?","Defined service and process expectations, measurement, root-cause analysis, continual improvement, and evidence that changes improve outcomes."],
      [2,"2B","What should be included in third-party and cloud governance?","Due diligence, clear responsibility allocation, security and service requirements, assurance rights, incident notification, continuity, and exit planning."],
      [3,"3A","How do project, program, portfolio, and PMO responsibilities differ?","A project delivers a defined outcome; a program coordinates related projects and benefits; a portfolio prioritizes investments; a PMO provides common oversight and methods."],
      [3,"3A","What should project-benefit realization verify?","Expected business benefits have owners, measures, baselines, and post-delivery tracking rather than being assumed when a system goes live."],
      [3,"3A","What should be established during project initiation?","A justified business need, measurable objectives, high-level scope, sponsor and stakeholders, governance, constraints, and authorization to proceed."],
      [3,"3A","Why validate business requirements before selecting or building a system?","Requirements define the needed business outcomes and controls; validated requirements reduce scope gaps, unnecessary features, and acceptance disputes."],
      [3,"3A","How should an organization choose an SDLC model?","Choose a model suited to uncertainty, risk, regulatory needs, delivery constraints, and stakeholder involvement, with controls appropriate to each lifecycle stage."],
